# Copy to functions/.env (deployed) or functions/.env.local (emulators). See docs/operations.md.

# Cloud Functions region. Must match VITE_FIREBASE_FUNCTIONS_REGION in the web app.
FUNCTIONS_REGION=europe-west1

# Reject callable requests without a valid Firebase App Check token.
ENFORCE_APP_CHECK=false

# Demo mode: the daily reset deletes ALL Auth users and Firestore data, then seeds sample data.
# Only enable it on a project dedicated to a public demo.
DEMO_MODE=false
# The reset runs only when this equals the deployed project ID. Leave empty to keep it disabled.
DEMO_PROJECT_ID=
