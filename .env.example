# Local development uses the Firebase Emulator Suite and a demo project ID.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ticknest.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ticknest
VITE_FIREBASE_APP_ID=demo-app-id

# Cloud Functions region. Must match FUNCTIONS_REGION in functions/.env (see docs/operations.md).
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Optional Firebase App Check (see docs/operations.md). Leave empty to disable.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_APP_CHECK_DEBUG_TOKEN=

# Demo mode (see docs/operations.md). When true, shows the daily-reset banner and demo accounts on sign-in.
# Leave false unless this Firebase project is a dedicated demo that is wiped every day.
VITE_DEMO_MODE=false

# Google sign-in (see docs/operations.md). Set to false to hide it on hosts that are not Firebase authorized domains,
# such as Vercel preview deployments. Unset or any other value keeps it.
VITE_GOOGLE_SIGN_IN_ENABLED=true

# Feature flags (see docs/operations.md). Each feature is on unless set to false.
# Budgets: My budgets, Budget progress and Budgets pages.
VITE_FEATURE_BUDGETS_ENABLED=true
