{
  "name": "ticknest",
  "private": true,
  "version": "1.4.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions,hosting --project demo-ticknest",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules,firestore:indexes,functions",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty",
    "lint:functions": "npm --prefix functions run lint",
    "typecheck:functions": "npm --prefix functions run build"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.33.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
