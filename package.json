{
  "name": "ticknest",
  "private": true,
  "version": "1.7.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions,hosting --project demo-ticknest",
    "test:emulators": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-ticknest \"vitest run --project emulator && node --test functions/test/*.test.mjs\"",
    "build": "tsc -b && vite build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules,firestore:indexes,functions",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty",
    "lint:functions": "npm --prefix functions run lint",
    "typecheck:functions": "npm --prefix functions run build",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "oxlint": "^1.89.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
