rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function isMember(workspaceId) {
      return signedIn()
        && exists(memberPath(workspaceId, request.auth.uid))
        && get(memberPath(workspaceId, request.auth.uid)).data.get('status', 'active') != 'removed';
    }

    function isOwner(workspaceId) {
      return isMember(workspaceId)
        && get(memberPath(workspaceId, request.auth.uid)).data.role == 'owner';
    }

    function validWorkspace(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'weekStartsOn', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'ownerUid', 'weekStartsOn', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.ownerUid == request.auth.uid
        && data.weekStartsOn is int
        && data.weekStartsOn >= 0
        && data.weekStartsOn <= 6
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(['displayName', 'email', 'timezone', 'palette', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.email == request.auth.token.email
        && data.timezone is string
        && data.timezone.size() <= 100
        && data.get('palette', 'system') in [
          'system', 'forest', 'ocean', 'plum', 'terracotta', 'forest-night', 'midnight', 'graphite'
        ];
    }

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120;
    }

    function validCreateTimestamps(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function validUpdateTimestamps(data) {
      return data.createdAt == resource.data.createdAt && data.updatedAt == request.time;
    }

    function optionalText(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function optionalNonNegativeInt(value) {
      return value == null || (value is int && value >= 0);
    }

    function validEntry(data) {
      return data.keys().hasAll([
          'userId', 'userDisplayName', 'description', 'clientId', 'projectId', 'taskId',
          'clientName', 'projectName', 'taskName', 'startAt', 'endAt', 'durationSeconds',
          'billable', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'userDisplayName', 'description', 'clientId', 'projectId', 'taskId',
          'clientName', 'projectName', 'taskName', 'startAt', 'endAt', 'durationSeconds',
          'billable', 'createdAt', 'updatedAt'
        ])
        && data.userId is string
        && data.userDisplayName is string
        && data.userDisplayName.size() <= 80
        && data.description is string
        && data.description.size() <= 1000
        && optionalText(data.clientId, 128)
        && optionalText(data.projectId, 128)
        && optionalText(data.taskId, 128)
        && optionalText(data.clientName, 120)
        && optionalText(data.projectName, 120)
        && optionalText(data.taskName, 120)
        && data.startAt is timestamp
        && (data.endAt == null || (data.endAt is timestamp && data.endAt > data.startAt))
        && (
          (data.endAt == null && data.durationSeconds == null)
          || (data.endAt is timestamp && data.durationSeconds is int && data.durationSeconds > 0)
        )
        && data.billable is bool;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid && validUserProfile(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'timezone', 'palette', 'updatedAt'])
        && validUserProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Collection-group query used to discover the current user's workspaces.
    match /{path=**}/members/{memberId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /workspaces/{workspaceId} {
      allow get: if isMember(workspaceId);
      allow list: if false;
      // Workspace creation and owner identity are written by trusted callable code.
      allow create, delete: if false;
      allow update: if isOwner(workspaceId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'weekStartsOn', 'updatedAt'])
        && validName(request.resource.data)
        && request.resource.data.weekStartsOn is int
        && request.resource.data.weekStartsOn >= 0
        && request.resource.data.weekStartsOn <= 6
        && validUpdateTimestamps(request.resource.data);

      match /members/{uid} {
        allow get, list: if isMember(workspaceId);
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow get: if isOwner(workspaceId)
          || (signedIn()
            && request.auth.token.email_verified == true
            && resource.data.email == request.auth.token.email);
        allow list: if isOwner(workspaceId);
        allow create, update, delete: if false;
      }

      match /clients/{clientId} {
        allow read: if isMember(workspaceId);
        allow create: if isOwner(workspaceId)
          && request.resource.data.keys().hasAll(['name', 'archived', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['name', 'archived', 'createdAt', 'updatedAt'])
          && validName(request.resource.data)
          && request.resource.data.archived is bool
          && validCreateTimestamps(request.resource.data);
        allow update: if isOwner(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'archived', 'updatedAt'])
          && validName(request.resource.data)
          && request.resource.data.archived is bool
          && validUpdateTimestamps(request.resource.data);
        allow delete: if isOwner(workspaceId);
      }

      match /projects/{projectId} {
        allow read: if isMember(workspaceId);
        allow create: if isOwner(workspaceId)
          && request.resource.data.keys().hasAll([
            'name', 'clientId', 'description', 'color', 'estimateMinutes', 'archived', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name', 'clientId', 'description', 'color', 'estimateMinutes', 'archived', 'createdAt', 'updatedAt'
          ])
          && validName(request.resource.data)
          && optionalText(request.resource.data.clientId, 128)
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 32
          && optionalNonNegativeInt(request.resource.data.estimateMinutes)
          && request.resource.data.archived is bool
          && validCreateTimestamps(request.resource.data);
        allow update: if isOwner(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'clientId', 'description', 'color', 'estimateMinutes', 'archived', 'updatedAt'
          ])
          && validName(request.resource.data)
          && optionalText(request.resource.data.clientId, 128)
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 32
          && optionalNonNegativeInt(request.resource.data.estimateMinutes)
          && request.resource.data.archived is bool
          && validUpdateTimestamps(request.resource.data);
        allow delete: if isOwner(workspaceId);
      }

      match /tasks/{taskId} {
        allow read: if isMember(workspaceId);
        allow create: if isOwner(workspaceId)
          && request.resource.data.keys().hasAll(['name', 'projectId', 'estimateMinutes', 'billable', 'archived', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['name', 'projectId', 'estimateMinutes', 'billable', 'archived', 'createdAt', 'updatedAt'])
          && validName(request.resource.data)
          && request.resource.data.projectId is string
          && request.resource.data.projectId.size() > 0
          && optionalNonNegativeInt(request.resource.data.estimateMinutes)
          && request.resource.data.billable is bool
          && request.resource.data.archived is bool
          && validCreateTimestamps(request.resource.data);
        // Tasks created before the billable flag existed may still lack it.
        allow update: if isOwner(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'projectId', 'estimateMinutes', 'billable', 'archived', 'updatedAt'])
          && request.resource.data.get('billable', false) is bool
          && validName(request.resource.data)
          && request.resource.data.projectId is string
          && request.resource.data.projectId.size() > 0
          && optionalNonNegativeInt(request.resource.data.estimateMinutes)
          && request.resource.data.archived is bool
          && validUpdateTimestamps(request.resource.data);
        allow delete: if isOwner(workspaceId);
      }

      match /timeEntries/{entryId} {
        function validEntry(data) {
          return data.keys().hasAll(['userId', 'description', 'clientName', 'projectName', 'taskName', 'billable', 'startAt', 'endAt', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['userId', 'userDisplayName', 'description', 'clientName', 'projectName', 'taskName', 'clientId', 'projectId', 'taskId', 'billable', 'startAt', 'endAt', 'createdAt', 'updatedAt'])
            && data.userId is string
            && (data.get('userDisplayName', null) == null || (data.get('userDisplayName', null) is string && data.get('userDisplayName', null).size() <= 320))
            && data.description is string
            && data.description.size() > 0
            && data.description.size() <= 500
            && (data.clientName == null || (data.clientName is string && data.clientName.size() <= 100))
            && (data.projectName == null || (data.projectName is string && data.projectName.size() <= 100))
            && (data.taskName == null || (data.taskName is string && data.taskName.size() <= 100))
            && (data.get('clientId', null) == null || (data.get('clientId', null) is string && data.get('clientId', null).size() <= 128))
            && (data.get('projectId', null) == null || (data.get('projectId', null) is string && data.get('projectId', null).size() <= 128))
            && (data.get('taskId', null) == null || (data.get('taskId', null) is string && data.get('taskId', null).size() <= 128))
            && data.billable is bool
            && data.startAt is timestamp
            && (data.endAt == null || (data.endAt is timestamp && data.endAt > data.startAt));
        }

        // Every referenced catalog item exists, is active, matches its name snapshot, and belongs to the
        // referenced parent.
        function validEntryReferences(data) {
          return (data.get('clientId', null) != null || data.clientName == null)
            && (data.get('projectId', null) != null || data.projectName == null)
            && (data.get('taskId', null) != null || data.taskName == null)
            && (data.get('clientId', null) == null
              || (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(data.get('clientId', null)))
                  && get(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(data.get('clientId', null))).data.archived == false
                  && get(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(data.get('clientId', null))).data.name == data.clientName))
            && (data.get('projectId', null) == null
              || (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(data.get('projectId', null)))
                  && get(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(data.get('projectId', null))).data.archived == false
                  && get(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(data.get('projectId', null))).data.name == data.projectName
                  && (get(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(data.get('projectId', null))).data.clientId == null
                    || get(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(data.get('projectId', null))).data.clientId == data.get('clientId', null))))
            && (data.get('taskId', null) == null
              || (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(data.get('taskId', null)))
                  && get(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(data.get('taskId', null))).data.archived == false
                  && get(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(data.get('taskId', null))).data.name == data.taskName
                  && get(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(data.get('taskId', null))).data.projectId == data.get('projectId', null)));
        }

        function validEntryCreate(data) {
          return validEntry(data)
            && data.createdAt == request.time
            && data.updatedAt == request.time;
        }

        allow get, list: if isMember(workspaceId)
          && (isOwner(workspaceId) || resource.data.userId == request.auth.uid);
        allow create: if isMember(workspaceId)
          && request.resource.data.userId == request.auth.uid
          && validEntryCreate(request.resource.data)
          && validEntryReferences(request.resource.data)
          // Clients create only running timers. Completed entries are written by the saveManualTimeEntry
          // callable, which checks overlaps in the same transaction as the write.
          && request.resource.data.endAt == null
          && request.resource.data.startAt == request.time
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/activeTimers/$(request.auth.uid)).data.entryId == entryId;
        // Clients may stop their own running timer or change its client, project, task, and billable state;
        // edits to completed entries go through the callable.
        allow update: if isMember(workspaceId)
          && resource.data.endAt == null
          && resource.data.userId == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endAt', 'updatedAt'])
              && request.resource.data.endAt is timestamp
              && request.resource.data.endAt > resource.data.startAt
              && !existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/activeTimers/$(request.auth.uid)))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'clientId', 'clientName', 'projectId', 'projectName', 'taskId', 'taskName', 'billable', 'updatedAt'
              ])
              && validEntry(request.resource.data)
              && validEntryReferences(request.resource.data))
          );
        allow delete: if isMember(workspaceId)
          && resource.data.endAt is timestamp
          && (isOwner(workspaceId) || resource.data.userId == request.auth.uid);
      }

      match /activeTimers/{uid} {
        allow get: if isMember(workspaceId) && (request.auth.uid == uid || isOwner(workspaceId));
        allow list: if false;
        allow create: if isMember(workspaceId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['entryId', 'startAt'])
          && request.resource.data.keys().hasOnly(['entryId', 'startAt'])
          && request.resource.data.entryId is string
          && request.resource.data.startAt == request.time
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/timeEntries/$(request.resource.data.entryId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/timeEntries/$(request.resource.data.entryId)).data.startAt == request.resource.data.startAt
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/timeEntries/$(request.resource.data.entryId)).data.endAt == null;
        allow update: if false;
        allow delete: if isMember(workspaceId)
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)/timeEntries/$(resource.data.entryId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/timeEntries/$(resource.data.entryId)).data.endAt == request.time;
      }

      match /{collection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
